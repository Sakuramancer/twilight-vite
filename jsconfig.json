{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "types": ["vite/client"],
    "paths": {
      "shared/*": ["./src/shared/*"],
      "entities/*": ["./src/entities/*"],
      "features/*": ["./src/features/*"],
      "widgets/*": ["./src/widgets/*"],
      "pages/*": ["./src/pages/*"],
      "app/*": ["./src/app/*"]
    }
  },
  "include": ["src"]
}
